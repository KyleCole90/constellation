{
  "name": "constellation-app",
  "version": "0.0.1-alpha.2",
  "private": true,
  "type": "module",
  "main": "out/main/index.mjs",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "node scripts/dev.mjs",
    "build": "vp build && vp pack",
    "typecheck": "tsgo -b",
    "test": "vp test run",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "knip": "knip",
    "verify": "npm run build && node scripts/verify.mjs",
    "dev:web": "vp dev",
    "verify:web": "node scripts/verify.mjs --web",
    "contract:live": "CONTRACT_LIVE=1 vp test run --reporter=verbose",
    "smoke:packaged": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --publish never && node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "electron-updater": "6.8.12",
    "lucide-react": "^1.71.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.4.0",
    "valibot": "1.5.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "knip": "6.45.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plus": "1.5.1"
  },
  "overrides": {
    "vite": "$vite"
  },
  "build": {
    "appId": "io.github.kylecole90.constellation",
    "directories": {
      "output": "out/release"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/dist/**",
      "!node_modules/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": true,
      "writeUpdateInfo": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "publish": {
      "provider": "github",
      "owner": "KyleCole90",
      "repo": "constellation",
      "releaseType": "draft"
    }
  },
  "productName": "Constellation"
}
